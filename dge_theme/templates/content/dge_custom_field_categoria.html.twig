{% set langcode = (url('<current>')|render|striptags|split('/'))[3] ?? 'es' %}

  {%- for item in categorias -%}
  {%- if item['#type'] == 'link' -%}
    {%- set term = item['#entity'] %}
    {%- set color = term.field_color.entity.field_color.color %}
    <div class="flex-display flex-center views-field-field-categoria">
      <div class="flex-display decoration-dot" style="background-color:{{ color }}"></div>
      <div class="flex-display">
        {{ term.getTranslation(langcode).name.value }}
      </div>
    </div>
  {%- endif %}
{%- endfor %}