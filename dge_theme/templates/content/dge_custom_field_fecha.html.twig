<!-- Fechas de actualización ficheros -->
{% set fechas_excluidas = ['10/09/2025', '11/09/2025','15/09/2025', '16/09/2025'] %}
<!-- Fechas de actualización rango migración -->
{% set fecha_inicio_exclusion = '2025-08-28' %}
{% set fecha_fin_exclusion = '2025-09-01' %}
<!-- Fecha de publicación -->
{% set field_fecha_public = fecha_publicacion[0]['#markup'] %}
{% set fecha_public_comparar = field_fecha_public ? field_fecha_public|date("Y-m-d") : null %}

<!-- Fecha publicación -->
{% set field_fecha_publicacion_contenid = fecha_publicacion_contenido[0]['#attributes']['datetime'] %}
{% set fecha_publicacion_comparar = fecha_publicacion_contenido[0]['#attributes']['datetime']|date("Y-m-d") %}

<!-- Fecha de actualización -->
{% set changed = fecha_actualizacion ? fecha_actualizacion|date("d/m/Y") : null %}
{% set changed_comparar = fecha_actualizacion ? fecha_actualizacion|date("Y-m-d") : null %}

<!-- Fecha de actualización peticion datos-->
{% set changed_data_request = fecha_actualizacion_peticion_datos ? fecha_actualizacion_peticion_datos|date("d/m/Y") : null %}

{% set dentro_rango_exclusion = changed_comparar >= fecha_inicio_exclusion and changed_comparar <= fecha_fin_exclusion %}

{% set show_fecha_actualizacion_aplicacion = changed is not empty 
and fecha_publicacion is not empty 
and changed_comparar != fecha_public_comparar 
and changed not in fechas_excluidas
and not dentro_rango_exclusion
%}

{% set show_fecha_actualizacion_empresa = changed is not empty
and fecha_publicacion_contenido is not empty
and changed_comparar != fecha_publicacion_comparar 
and changed not in fechas_excluidas
and not dentro_rango_exclusion
%}

{% set show_fecha_actualizacion_peticion_datos = changed_data_request is not empty
%}



{% if field_fecha_public is not empty %}
<!-- Fecha publicación -->
<div class="flex-display flex-center flex-row mb-4">
  <span class="pl-5 b-l mb-0"></span>
  <div class="flex-display flex-column">
    <span class="label bold primary-color-dark mb-2">{{ fecha_publicacion['#title'] }}</span>
    <span class="label primary-color-semi-dark mb-0">{{ field_fecha_public|date("d/m/Y") }}</span>
  </div>
</div>
{% endif %}

{% if field_fecha_publicacion_contenid is not empty %}
<!-- Fecha publicación contenido-->
<div class="flex-display flex-center flex-row mb-4">
  <span class="pl-5 b-l mb-0"></span>
  <div class="flex-display flex-column">
    <span class="label bold primary-color-dark mb-2">{{ fecha_publicacion_contenido['#title'] }}</span>
    <span class="label primary-color-semi-dark mb-0">{{ field_fecha_publicacion_contenid|date("d/m/Y") }}</span>
  </div>
</div>
{% endif %}

{% if show_fecha_actualizacion_peticion_datos  and not show_fecha_actualizacion_empresa and not  show_fecha_actualizacion_aplicacion  %}
<!-- Fecha actualizacion peticion datos -->
<div class="flex-display flex-center flex-row mb-4">
    <span class="pl-5 b-l mb-0"></span>
    <div class="flex-display flex-column">
        <span class="label bold primary-color-dark mb-2">{{ 'Fecha actualización'|t }}</span>
        <span class="label primary-color-semi-dark mb-0">{{ changed_data_request }}</span>
    </div>
</div>
{% endif %}

{% if show_fecha_actualizacion_aplicacion or show_fecha_actualizacion_empresa  %}
<!-- Fecha actualizacion -->
<div class="flex-display flex-center flex-row mb-4">
    <span class="pl-5 b-l mb-0"></span>
    <div class="flex-display flex-column">
        <span class="label bold primary-color-dark mb-2">{{ 'Fecha actualización'|t }}</span>
        <span class="label primary-color-semi-dark mb-0">{{ changed }}</span>
    </div>
</div>
{% endif %}