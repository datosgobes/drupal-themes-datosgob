{%
set classes = ['node','node--type-' ~ node.bundle|clean_class,
node.isPromoted() ? 'node--promoted', node.isSticky() ? 'node--sticky',
not node.isPublished() ? 'node--unpublished', view_mode ? 'node--view-mode-' ~ view_mode|clean_class,]
%}
{% set mime_map = {
  "application/pdf": "PDF",
  "application/msword": "DOC",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document": "DOCX",
  "application/vnd.ms-excel": "XLS",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": "XLSX",
  "application/vnd.ms-powerpoint": "PPT",
  "application/vnd.openxmlformats-officedocument.presentationml.presentation": "PPTX",
  "application/vnd.oasis.opendocument.text": "ODT",
  "application/octet-stream": "RMD",
  "application/rar": "RAR",
  "application/epub+zip": "EPUB",
  "image/jpeg": "JPG",
  "image/png": "PNG",
  "image/gif": "GIF",
  "text/plain": "TXT",
  "application/zip": "ZIP"
} %}
{{ attach_library('dge_theme/node') }}
<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if label and not page %}
  <h2{{ title_attributes }}>
  <a href="{{ url }}" rel="bookmark">{{ label }}</a>
  </h2>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('node__content') }}>
    <div class="container flex-flow-column relative">
      {% set fecha_render = fecha_publicacion[0]['#attributes']['datetime'] %}
      {% set fecha_publicacion_comparar = fecha_publicacion[0]['#attributes']['datetime']|date("Y-m-d") %}

      {% set changed = fecha_actualizacion|date("d/m/Y") %}
      {% set changed_comparar = fecha_actualizacion|date("Y-m-d") %}

      {% set fecha_inicio_exclusion = '2025-08-28' %}
      {% set fecha_fin_exclusion = '2025-09-01' %}
      {% set dentro_rango_exclusion = changed_comparar >= fecha_inicio_exclusion and changed_comparar <= fecha_fin_exclusion %}

      {% set tipo_render = tipo|render|striptags|trim %}

      <div class="flex-display flex-justify-between">
        <div class="flex-display flex-column mr-auto mt-5">
          <div class="container mt-auto flex-gap-1-4 mt-4">
            {% if fecha_render is not empty %}
            <div class="flex-display flex-center flex-row mb-4">
              <span class="pl-5 b-l mb-0"></span>
              <div class="flex-display flex-column">
                <span class="label bold primary-color-dark mb-2">{{ fecha_publicacion['#title'] }}</span>
                <span class="label primary-color-semi-dark mb-0">{{ fecha_render|date("d/m/Y") }}</span>
              </div>
            </div>
            {% endif %}

            {% if changed is not empty 
            and changed_comparar != fecha_publicacion_comparar
            and changed not in ['10/09/2025', '11/09/2025', '15/09/2025', '16/09/2025']
            and not dentro_rango_exclusion
             %}
            <div class="flex-display flex-center flex-row mb-4">
                <span class="pl-5 b-l mb-0"></span>
                <div class="flex-display flex-column">
                    <span class="label bold primary-color-dark mb-2">{{ 'Fecha actualización'|t }}</span>
                    <span class="label primary-color-semi-dark mb-0">{{ changed }}</span>
                </div>
            </div>
            {% endif %}

            {% if tipo_render is not empty %}
            <div class="flex-display flex-center flex-row mb-4">
              <span class="pl-5 b-l mb-0"></span>
              <div class="flex-display flex-column">
                <span class="label bold primary-color-dark mb-2">{{ tipo['#title'] }}</span>
                {% set current_path = path('<current>') %}
                {% set language = current_path|split('/')|slice(1,1)|join %}

                <span class="label primary-color-semi-dark mb-0">
                  <a href="/{{ language }}/conocimiento/tipo/{{ tipo[0]['#title']|lower|replace({' ': '-'}) }}-{{tipo[0]['#options'].entity.id}}">
                    {{ tipo[0]['#title'] }}
                  </a>
                
                </span>
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="container-share">
        {{ drupal_block('social_sharing_block', {id : 'social_sharing_block', wrapper: false,label : 'Social Sharing block',label_display : 0,provider : 'social_media' }) }}
      </div> 
    </div>

    {% set nombre_render = nombre|render %}
    {% set sector_render = sector|render %}
    {% set organismoInstitucion_render = organismoInstitucion|render %}
    {% set pais_render = pais|render %}
    {% set especializacion_render = especializacion|render %}
    {% set trabajosDestacar_render = trabajosDestacar|render %}
    {% set pagWeb_render = pagWeb|render %}

    {% if nombre_render is not empty or
    sector_render is not empty or
    organismoInstitucion_render is not empty or
    pais_render is not empty or
    especializacion_render is not empty or
    trabajosDestacar_render is not empty or
    pagWeb_render is not empty %}
    <div class="container flex-start">

    {% if sector_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ sector['#title'] }}</span>
          {% set params = {
            categorias: sector
            } 
          %}
          
          {% include directory ~ '/templates/content/dge_custom_field_categoria.html.twig' with params %}
        </div>
      </div>
      {% endif %}

      {% if nombre_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ nombre['#title'] }}</span>
          <span class="label primary-color-semi-dark mb-0">{{ nombre[0] }}</span>
        </div>
      </div>
      {% endif %}

      {% if organismoInstitucion_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ organismoInstitucion['#title'] }}</span>
          <span class="label primary-color-semi-dark mb-0">{{ organismoInstitucion[0] }}</span>
        </div>
      </div>
      {% endif %}

      {% if pais_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ pais['#title'] }}</span>
          <span class="label primary-color-semi-dark mb-0">{{ pais[0] }}</span>
        </div>
      </div>
      {% endif %}

      {% if especializacion_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ especializacion['#title'] }}</span>
          <span class="label primary-color-semi-dark mb-0">{{ especializacion[0] }}</span>
        </div>
      </div>
      {% endif %}

      {% if trabajosDestacar_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ trabajosDestacar['#title'] }}</span>
          <span class="label primary-color-semi-dark mb-0">{{ trabajosDestacar[0] }}</span>
        </div>
      </div>
      {% endif %}

      {% if pagWeb_render is not empty %}
      <div class="flex-display flex-center flex-row mb-4">
        <span class="pl-5 b-l mb-0"></span>
        <div class="flex-display flex-column">
          <span class="label bold primary-color-dark mb-2">{{ pagWeb['#title'] }}</span>
          <span class="label primary-color-semi-dark mb-0">{{ pagWeb[0] }}</span>
        </div>
      </div>
      {% endif %}

    </div>
    {% endif %}


    <div class="container-descripcion-image">

      {% if imagen is not empty %}
        <div class="container-image">
          {{ imagen }}
        </div>
      {% endif %}

      <div class="container-descripcion">
        <div>

          {% if fecha_evento is not empty and fecha_evento['#items'] is not empty %}
            {% set datetime_str = fecha_evento['#items'].0.value %}
            {% set fecha_obj = datetime_str|date('Y-m-d H:i:s') %}
            {% set day = fecha_obj|date('d') %}
            {% set year = fecha_obj|date('Y') %}
            {% set timestamp = datetime_str|date('U') %}
            {% set url_parts = url|split('/') %}
            {% set lang_code = url_parts[1] is defined ? url_parts[1] : '' %}
            {% if lang_code != 'en' %}
              {% set lang_code = 'es' %}
            {% endif %}

            {% if lang_code is not empty and timestamp is not empty %}
            <div class="container-descripcion__event event-date">
                <div class="event-date--month">
                  {{ timestamp|format_date('long', '', null, lang_code)|split(' ')|slice(1, 1)|first }}
                </div>
                <div class="event-date--day">
                    <div class="event-date--day_number">
                        {{ day }}
                    </div>
                    <div class="event-date--day_week">
                      {{ timestamp|format_date('long', '', null, lang_code)|split(' ')|first|replace({',': ''}) }}
                    </div>
                </div>
                <div class="event-date--year">
                    {{ year }}
                </div>
            </div>
            {% endif %}
          {% endif %}

          {{ descripcion }}
        </div>
      </div>
    </div>

    {% set fuente_render = fuente|render|striptags|trim %}
    {% if fuente_render is not empty %}
    <div class="container mt-6">
      <div class="flex-display">
        {{ fuente }}
      </div>
    </div>
    {% endif %}

    {% set ficheros_adjuntos_render = ficheros_adjuntos|render %}
    {% set ficheros_externos_adjuntos_render = ficheros_externos_adjuntos|render %}
    {% if ficheros_adjuntos_render is not empty or ficheros_externos_adjuntos_render is not empty%}
      <div class="container mt-6">
        <div class="flex-display flex-column">
          <h3>
            <span class="field field--name-title">{{ 'Documentation' | t }}</span>
          </h3>
        </div>
      </div>
      <div class="container mt-4">
        <div class="table-wrapper">
          <table>
            <caption style="display:none;">Tabla ficheros externos adjuntos</caption>
            <tbody>
              <th scope="col" aria-hidden="true" style="display:none;"></th>
              {% if ficheros_adjuntos_render is not empty %}
                {% for fichero in ficheros_adjuntos %}
                  {% if fichero['#file'] is defined %}
                    {% set file = fichero['#file'] %}
                    {% set url = file.getFileUri()|file_url %}
                    {% set file_size = file.getSize() %}
                    {% if file_size < 1024 %}
                      {% set size = file_size ~ ' B' %}
                    {% elseif file_size < 1048576 %}
                      {% set size = (file_size / 1024)|number_format(2, '.', ',') ~ ' KB' %}
                    {% elseif file_size < 1073741824 %}
                      {% set size = (file_size / 1048576)|number_format(2, '.', ',') ~ ' MB' %}
                    {% else %}
                      {% set size = (file_size / 1073741824)|number_format(2, '.', ',') ~ ' GB' %}
                    {% endif %}
                    {% set mime_type = file.getMimeType() %}
                    {% set type = mime_map[mime_type] is defined ? mime_map[mime_type] : mime_type %}
                    
                    {% set filename = fichero['#file'].getFilename() %}
                    {% set description = fichero['#description'] is not empty ? fichero['#description'] : filename %}

                    <tr>
                      <td class="w--100" style="min-width: 16rem;">{{ description }}</td>
                      <td class="white-space-nowrap float-none align-right">{{ size }}</td>
                      <td class="float-none align-right">
                        <span class="badge-files" data-format="{{ type|lower }}">{{ type }}</span>
                      </td>
                      <td>
                        <a href="{{ url }}" title="Descarga del documento &quot;{{ description }}&quot;. Abre una nueva ventana" class="icon-link" tabindex="-1" target="_blank" rel="noopener noreferrer">
                          <span class="file">
                            <img src="/themes/custom/dge_theme/images/icons/file.svg" alt="descarga fichero">
                          </span>
                          </a>
                        </td>
                    </tr>
                  {% endif %}
              {% endfor %}
            {% endif %}
            {% if ficheros_externos_adjuntos_render is not empty %}
                {{ ficheros_externos_adjuntos }}
            {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    {% endif %}

    

    {% set url_video_youtube_render = url_video_youtube|render %}
    {% if url_video_youtube_render is not empty %}
    <div class="container mt-6">
      <div class="flex-display">
        {{ url_video_youtube }}
      </div>
    </div>
    {% endif %}
    
    {% set etiquetas_render = etiquetas|render|striptags|trim %}
    {% if etiquetas_render is not empty %}
    <div class="container mt-6">
      <div class="flex-display tags--indexed">
        {{ etiquetas }}
      </div>
    </div>
    {% endif %}

    {% set contenido_relacionado_render = contenido_relacionado|render %}
    {% if contenido_relacionado_render is not empty %}

    <div class="container mt-6">
      <div class="flex-display flex-auto flex-column">
        {{ contenido_relacionado }}
      </div>
    </div>
    {% endif %}

 
    <div class="separator separator--gray"></div>

    
    <div class="container mt-6">
      <div class="flex-display w--100">
        {{ comment }}
      </div>
    </div>

  </div>
</article>