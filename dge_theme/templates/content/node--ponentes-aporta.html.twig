{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('dge_theme/node') }}
<article{{ attributes.addClass(classes) }}>
<h3 class="visually-hidden">{{ title }}</h3>
  <div{{ content_attributes.addClass('node__content') }}>

    {% if node.field_share_social_media.value == '1'%}
         {{ drupal_block('social_sharing_block', {id : 'social_sharing_block', wrapper: false,label : 'Social Sharing block',label_display : 0,provider : 'social_media' }) }}
    {% endif %}

    {{ content.field_photo }}

    {% if label and not page %}
        {{ label }}
    {% endif %}

    {{ content.links }}
    {{ content.field_departament }}

    {{ content.field_twitter }}
    {{ content.field_linkedin }}

  </div>

</article>
