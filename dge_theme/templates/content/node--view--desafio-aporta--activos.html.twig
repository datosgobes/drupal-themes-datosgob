<article class="desafio--actual mb-10">
  <div class="container flex-nowrap flex-column">
    <div class="flex-display flex-center desafio--actual__img">
      {{ content.field_image }}
    </div>
    <div class="flex-display flex-column">
      {% if label and not page %}
        <div class="desafio-card flex-display flex-column">
          <div class="flex-display flex-row flex-gap-1 responsive-md-flex-column flex-justify-between">
            <div class="desafio--actual__title">
              {{ label }}
            </div>
            {% set editionState = 'Edition active' | t %}
            <div class="desafio__estado flex-display flex-center" style="background-color:{{ content.field_inscriptions_taxonomy[0]['#taxonomy_term'].field_color.color }}40;">
              <div class="flex-display decoration-dot" style="background-color:{{ content.field_inscriptions_taxonomy[0]['#taxonomy_term'].field_color.color }}"></div>
              <div class="flex-display desafio__estado__text">{{ editionState }}</div>
            </div>
          </div>
          <div class="desafio--actual__subtitle">
              {{ content.field_aporta_subtitle }}
            </div>
          <div{{ content_attributes.addClass('node__content') }}>
            <div class="desafio__descripcion">
              {{ content.field_descripcion }}
            </div>
            
          </div>
        </div>
      {% endif %}

      <div class="btn-link--primary">
        <div class="field field--name-field-button-primary field--type-link field--label-hidden field__item flex-justify-end">
          <a href="{{ url }}">{{ 'See information' | t}}
            <span class="decoration-arrow"><img src="/themes/custom/dge_theme/images/icons/decoration-arrow.svg" alt="Decoration arrow icon"></span>
          </a>
        </div>
      </div>

    </div>
    <div{{ content_attributes.addClass('node__content') }}>
      {% if node.field_share_social_media.value == '1'%}
          {{ drupal_block('social_sharing_block', {id : 'social_sharing_block', wrapper: false,label : 'Social Sharing block',label_display : 0,provider : 'social_media' }) }}
      {% endif %}
    </div>
  </div>
</article>
