<article class="desafio desafio--anterior">
  <div class="container flex-nowrap flex-column">
      <div class="flex-display flex-center desafio--anterior__img">
        {{ content.field_image }}
        <div class="desafio--anterior__img-opacity"></div>
      </div>
    {% if label and not page %}
    <a href="{{ url }}">
      <div class="desafio-card flex-display flex-column">
        <div class="flex-display flex-row flex-gap-1 responsive-md-flex-column flex-justify-between">
          <div class="desafio--anterior__title">
            <h3{{ title_attributes }}>
              {{ label[0]['#context'].value }}: {{ content.field_aporta_subtitle[0]['#context'].value }}
            </h3>
          </div>
          <div class="desafio__estado concluido flex-display flex-center">
            <div class="flex-display decoration-dot"></div>
            <div class="flex-display desafio__estado__text">{{ 'Edition concluded' | t }}</div>
          </div>
        </div>
        <div{{ content_attributes.addClass('node__content') }}>
          <div class="desafio__descripcion">
            {{ content.field_descripcion }}
          </div>
          <div class="desafio__date flex-display mt-4 flex-center regular datetimeViews">
            <span class="flex-display icon--md mr-2"><img src="/themes/custom/dge_theme/images/icons/calendario.svg"
                alt="calendar icon"></img></span>
              {{ node.field_aporta_date.value|date("d/m/Y") }}
          </div>
        </div>
      </div>
    </a>
    {% endif %}
  </div>
</article>