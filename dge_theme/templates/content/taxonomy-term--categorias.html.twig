{%
  set classes = [
    'taxonomy-term',
    'vocabulary-' ~ term.bundle|clean_class,
  ]
%}
{% set link = content.field_link[0]['#title'] %}
{% if link %}
  <a href="{{ link }}" class="taxonomy-category">
    <div{{ attributes.setAttribute('id', 'taxonomy-term-' ~ term.id).addClass(classes) }}>
      <div class="taxonomy-category-card">
        <div class="taxonomy-category-card-image">
          {{content.field_category_image}}
        </div>
        <div class="taxonomy-category-card-title">
          {{ name }}
          <div class="decoration-line decoration-line__sm decoration-line__white mt-1 ml-auto mr-auto">&nbsp;</div>
        </div>
      </div>
    </div>
  </a>
{% endif %}
