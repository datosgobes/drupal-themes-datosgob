{#
/**
 * @file
 * Default theme implementation of a facet result item.
 *
 * Available variables:
 * - value: The item value.
 * - raw_value: The raw item value.
 * - show_count: If this facet provides count.
 * - count: The amount of results.
 * - is_active: The item is active.
 * - facet: The facet for this result item.
 *   - id: the machine name for the facet.
 *   - label: The facet label.
 *
 * @ingroup themeable
 */
#}
{%- set category_entity = drupal_entity('taxonomy_term', raw_value) %}
{% if category_entity %}
    <div class="facet-item__content{% if is_active %} active{% endif %}">
        {% if category_entity['#taxonomy_term'].field_faq_categoria_media is not empty %}
            {% set media = category_entity['#taxonomy_term'].field_faq_categoria_media %}
            {% set image_file = media.entity.field_media_image %}
            {% set image_url = file_url(image_file.entity.fileuri) %}
            {% set image_alt = image_file.alt %}
            <div class="facet-item__content__img">
                <img src="{{ image_url }}" alt="{{ image_alt }}"/>
            </div>
        {% endif %}
        <div class="facet-item__content__title">
            <span class="facet-item__value">{{ value }}</span>
        </div>
        {% if show_count %}
        <div class="facet-item__content__count">
            <span class="facet-item__count">({{ count }})</span>
        </div>
        {% endif %}
    </div>
{% endif %}

