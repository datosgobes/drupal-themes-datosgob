<div class="tabs">
  <div class="facets-widget-links">
    <ul class="item-list__links mb-5">
      {% for key, item in items %}
        <li class="facet-item {% if loop.first %} active{% endif %}">
          <a href="#" onclick="changeTab(event, 'tab{{ key }}')">
            <div class="facet-item__content">
              {% if item.content['#paragraph'].get('field_imagen') is not empty %}
                {% set media = item.content['#paragraph'].get('field_imagen') %}
                {% set image_file = media.entity.field_media_image %}
                {% set image_url = file_url(image_file.entity.fileuri) %}
                {% set image_alt = image_file.alt %}
                <div class="facet-item__content__img">
                  <img src="{{ image_url }}" alt="{{ image_alt }}" />
                </div>
              {% endif %}
              <div class="facet-item__content__title">
                <span class="facet-item__value">{{ item.content['#paragraph'].get('field_titulo').value }}</span>
              </div>
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

<div class="separator separator--primary-light mt-2 mb-2"></div>

{% for key, item in items %}
  <div id="tab{{ key }}" class="tabcontent" {% if loop.first %} style="display: block;" {% else %} style="display: none;" {% endif %}>

   {% if item.content['#paragraph'].field_enlace_descarga_csv is not empty %}
      {% for enlace in item.content['#paragraph'].field_enlace_descarga_csv %}
        {% if enlace.uri is not empty %}
          <a href="{{ enlace.url  }} " target="_self">{{ enlace.title }}</a>
        {% endif %}
      {% endfor %}
    
    {% endif %}


    {{ item.content['#paragraph'].field_description.value }}
    {{ item.content }}
  </div>
{% endfor %}



<script>
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelector(".facet-item.active .facet-item__content").classList.add("active");
    });

    function changeTab(event, tabId) {
      event.preventDefault();
      document.querySelectorAll(".tabcontent").forEach(tab => {
        tab.style.display = "none";
      });

      let selectedTab = document.getElementById(tabId);
      selectedTab.style.display = "block";

      let iframe = selectedTab.querySelector("iframe");
      if (iframe) {
        let currentSrc = iframe.getAttribute("src") || iframe.dataset.src;
        iframe.removeAttribute("src");
        setTimeout(() => {
          iframe.src = currentSrc;
        }, 100);
      }

      document.querySelectorAll(".facet-item__content").forEach(content => {
        content.classList.remove("active");
      });
      event.currentTarget.querySelector(".facet-item__content").classList.add("active");
    }

</script>
