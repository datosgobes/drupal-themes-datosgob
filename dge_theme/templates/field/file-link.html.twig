{#
/**
 * @file
 * Theme override for a link to a file.
 *
 * Available variables:
 * - attributes: The HTML attributes for the containing element.
 * - link: A link to the file.
 * - icon: The icon image representing the file type.
 * - file_size: The size of the file.
 *
 * @see template_preprocess_file_link()
 */
#}
{{ attach_library('dge_theme/file') }}

{% set label = file.getFilename() %}
{% set extension = label|split('.')|last %}
<span{{ attributes }}>
    <span class="file--link">

        {% set title_string = link['#title'] %}

        {% set link = link|merge({
            '#options': link['#url'].options|merge({
                'attributes': link['#url'].options.attributes|merge({
                    'target': '_blank',
                    'title': ('Download the document'|t ~ ' "' ~ title_string ~ '". ' ~ 'Open a new window'|t)
                })
            })
        }) %}

         {{ link }}
    </span>
    <span class="file--extension-size">
        {{ file_size }} 
        {{ extension }}
    </span>
</span>
