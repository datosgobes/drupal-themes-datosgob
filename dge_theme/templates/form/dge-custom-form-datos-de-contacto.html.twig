<div class="container">
  <div class="col-1">
    <h4 class="mb-3 titleBold">{{ title }}</h4>
  </div>
</div>

<div class="container">
  <div class="col-3">
    {{ name_and_surname }}
  </div>
  <div class="col-3">
    {{ email }}
  </div>
  {% if phone_number is not empty %}
  <div class="col-3">
    {{ phone_number }}
  </div>
  {% endif %}
  {% if company is not empty %}
  <div class="col-3">
    {{ company }}
  </div>
  {% endif %}
</div>

<div class="container">
  <div class="col-1" title="{{ 'Select this checkbox if you want to continue'|t }}">
    {{ consent_1 }}
  </div>
</div>

<div class="container">
  <div class="col-1">
    <label class="option" title="{{ 'Select this checkbox if you want to continue'|t }}">
      {{ consent_2 }} 
    </label>
  </div>
</div>






