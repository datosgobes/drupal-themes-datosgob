<div class="container">
  <div class="col-1">
    {% if title %}
    <h4 class="mb-3 titleBold">{{ title | t }}</h4>
    {% else %}
    <h4 class="mb-3 titleBold">{{ 'General information' | t }}</h4>
    {% endif %}
  </div>
</div>

{% if autor_desarrollador %}
  <div class="container">
    <div class="col-3">
      {{ element.title }}
    </div>
    <div class="col-3">
      {{ element.field_categoria }}
    </div>
    <div class="col-3">
      {{ autor_desarrollador }}
    </div>
  </div>
{% else %}
  <div class="container">
    <div class="col-66">
      {{ element.title }}
    </div>
    <div class="col-3">
      {{ element.field_categoria }}
    </div>   
  </div>
{% endif %}

<div class="container">
  <div class="col-1">
    {{ element.field_descripcion }}
  </div>
</div>