{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}
<form{{ attributes }}>
  
    {% set params = {
      element: element
      }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-datos-obligatorios.html.twig' with params %}

{{element.author.name}}
{{element.author.mail}}
{{element.comment_body}}
{{element.field_acepto_las_condiciones_del}}

 {% set params = {
      actions: element.actions
      }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-action-buttons.html.twig' with params %}

</form>