<div class="mt-8">

  <form{{ attributes }}>
    {% set params = {
      element: element
      }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-datos-obligatorios.html.twig' with params %}

    {% set params = {
      element: element,
      title: 'Request Information'
      }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-informacion-general.html.twig' with params %}

    <div class="container">
      <div class="col-1">
        {{ element.field_motivo_de_la_peticion }}
      </div>
    </div>
    
    <div class="container">
      <div class="col-1">
        {{ element.field_beneficios_esperados }}
      </div>
    </div>

    <div class="container">
      <div class="col-1">
        {{ element.field_respuesta }}
      </div>
    </div>

    <div class="container">
      <div class="col-2">
        {{ element.field_organismo_responsable }}
      </div>
      <div class="col-2">
        {{ element.field_publicador }}
      </div>
    </div>

    <div class="container">
      <div class="col-1">
        {{ element.field_url_del_conjunto_de_datos }}
      </div>
    </div>

    <div class="container">
      <div class="col-1">
        {{ element.field_estado }}
      </div>
    </div>

    <div class="container">
      <div class="col-1">
        {{ element.field_fecha_publicacion_contenid }}
      </div>
    </div>

    <div class="container">
      <div class="col-1">
        {{ element.comment }}
      </div>
    </div>

    <div class="col-1">
      {{ element.footer }}
    </div>

    {% set altTitle = 'Requester Information' | t %}
    {% set params = {
      title: altTitle,
      name_and_surname: element.group_datos_de_contacto[3],
      email: element.group_datos_de_contacto[1],
      company: element.group_datos_de_contacto[4],
      consent_1: element.group_datos_de_contacto[2],
      consent_2: element.group_datos_de_contacto[0],
      }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-datos-de-contacto.html.twig' with params %}
    
    {% set params = {
      actions: element.actions
    }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-action-buttons.html.twig' with params %}
    
  </form>
</div>