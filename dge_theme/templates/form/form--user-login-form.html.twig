{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}

<h4 class="mb-3">{{'Do you already have an account? Enter as an Organisation.' | t}}</h4>
<label class="mb-3">{{'Please be aware that this login is for organisations, not individuals.'| t}} <strong>{{'Private users do not need to register to use our platform.' | t }}</strong>
</label>

<div class="login-form login-form__wrapper mt-8">
    <form{{ attributes }}>
        <div class="login-form__top">

            <div class="separator"><span class="separator__text">{{'Already registered' | t}}</span></div>

            <div id="error_messages"></div>
            {{ element.messages }}
            {{ element.name }} {# username element #}
            {{ element.pass }} {# password element #}
            <div class="login-form__help_actions mb-5" style="display: none;">
                <input id="show_password" class="show_password" type="checkbox" />
                <label class="password-toggle" for="show_password">{{'Remember password' | t}}</label>
            </div>
            {{ element.form_build_id }} {# required #}
            {{ element.form_id }} {# required #}
            <div class="login-form__submit align-center mb-4">
                {{ element.actions.submit }}
            </div>

            <div class="login-form__forgot align-center">
              <a href="/user/password" class="forgot-password" title="{{ 'I have forgotten my password' | t }}">{{'I have forgotten my password' | t}}</a>
            </div>

            <div class="separatorOr"><span class="separator__textOr">{{'or' |t}}</span></div>

            <div class="login-form__register align-center">
                <span class="a-text--form-note_new">{{ 'Don’t have an account? ' | t }}<a href="/user/register" title="{{ 'Register here' | t }}">{{ 'Register here' | t }}</a></span>
            </div>

        </div>
    </form>
</div>



<style>
.region-footer-top, .footer-colaborators, nav.tabs {
  display: none !important;
}
.footer-info {
  top: 0rem !important;
}
</style>