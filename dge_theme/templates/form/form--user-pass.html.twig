{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}

<h4 class="mb-3">{{'Have you forgotten your password?' | t}}</h4>

<label class="mb-3"> {{'Please enter your registered email address below.' | t}} <strong>{{'We will send you a link to reset your password' |t}}</strong>
</label>

<div class="login-form login-form__wrapper mt-8">
    <form{{ attributes }}>
        <div class="login-form__top">

            <div id="error_messages"></div>
            {{ element.messages }}
            {{ element.name }} {# username element #}
            
            {{ element.form_build_id }} {# required #}
            {{ element.honeypot_time }}
            {{ element.form_id }} {# required #}
            
            <div class="login-form__submit mb-4">
                {{ element.actions.submit }}
            </div>

            <div class="login-form__login align-center">
              <a href="/user/login" class="forgot-password">{{'Log in' |t}}</a>
            </div>

        </div>
    </form>
</div>



<style>
.region-footer-top, .footer-colaborators, nav.tabs {
  display: none !important;
}
.footer-info {
  top: 0rem !important;
}
</style>