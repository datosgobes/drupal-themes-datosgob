{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}

<div class="login-form login-form__wrapper mt-8">
    <form{{ attributes }}>

      <div id="error_messages"></div>

      <div class="container">
        {{ element.messages }}
      </div>
      <div class="container">
        <div class="col-3">
         {{ element.account.mail }} {# mail element #}
        </div>
        <div class="col-3">
          {{ element.account.name }} {# mail element #}
        </div>
      </div>

      <div>
        {{ element.form_build_id }}
        {{ element.honeypot_time }}
        {{ element.form_id }}
      </div>

      <div class="container">
        <div class="col-3">
        {{ element.field_nombre }} {# nombre element #}
        </div>
        <div class="col-3">
        {{ element.field_apellidos }} {# apellidos element #}
        </div>
        <div class="col-3">
          {{ element.field_telefono }} {# telefono element #}
        </div>
        <div class="col-3">
          {{ element.field_posicion }} {# posicion element #}
        </div>
        <div class="col-3">
          {{ element.field_organizacion }} {# organizacion element #}
        </div>
        <div class="col-3">
          {{ element.field_dir3 }} {# dir3 element #}
        </div>
      </div>
      <div class="container">
        <div class="col-1">
        {{ element.field_comentarios_adicionales }} {# comentarios_adicionales element #} </div>
        <div class="col-1">
        {{ element.field_terminos_de_servicio }} {# terminos_de_servicio element #} 
        </div>
      </div>

      <div class="container mt-5 mb-5">
        <div class="col-3 align-center">
          <div class="login-form__submit">
            {{ element.actions.submit }}
          </div>
        </div>
      </div>

    </form>
</div>


<style>
.region-footer-top, .footer-colaborators, nav.tabs {
  display: none !important;
}
.footer-info {
  top: 0rem !important;
}
</style>