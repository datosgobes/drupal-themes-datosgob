{#
/**
 * @file
 * Theme override for a form element (checkbox).
 *
 * @see template_preprocess_form_element()
 */
#}

{% if logged_in == false %}
  {%
    set classes = [
      'form-item',
      'form-type--boolean',
      'form-item--acepto-condiciones',
    ]
  %}

<div class="js-form-item form-item js-form-type-checkbox form-type-checkbox js-form-item-field-terminos-de-servicio-value form-item-field-terminos-de-servicio-value">
  {# Renderiza el checkbox #}
   <input type="checkbox" id="{{ element['#id'] }}" name="{{ element['#name'] }}" value="1" class="form-checkbox required form-text" required="required" aria-required="true">
   <label for="{{ element['#id'] }}" class="option js-form-required form-required">
      {{ description.content | raw }} {# Muestra la descripción al lado del checkbox #}
    </label>
   
</div>

{% endif %}