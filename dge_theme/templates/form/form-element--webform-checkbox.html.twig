{# webform--contact--acepto-las-condiciones-de-servicio.html.twig #}

<div class="form-item form-item-acepto-las-condiciones-de-servicio" title="{{ 'Select this checkbox if you want to continue'|t }}">
  <input type="checkbox" id="{{ element['#id'] }}" name="{{ element['#name'] }}" value="1" class="form-checkbox required form-text" required="required" aria-required="true">
  <label for="{{ element['#id'] }}" class="option js-form-required form-required">
    {{ element['#description']['#markup'] | raw }} {# Muestra la descripción al lado del checkbox #}
  </label>
</div>
