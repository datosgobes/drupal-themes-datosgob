{#
/**
 * @file
 * Theme override for a select element.
 *
 * Available variables:
 * - attributes: HTML attributes for the <select> tag.
 * - options: The <option> element children.
 *
 * @see template_preprocess_select()
 */
#}
{% apply spaceless %}

{% set select_attributes = attributes.addClass('select_visually_hidden').setAttribute('tabindex', '-1') %}
{% set dropdown_attributes = create_attribute(attributes.toArray()|without('id')) %}
{% set dropdown_attributes = dropdown_attributes.removeClass('select_visually_hidden') %}
{% if attributes.hasAttribute('data-editor-for') %}
  {% set dropdown_attributes = dropdown_attributes.removeAttribute('data-editor-for') %}
  {% set dropdown_attributes = dropdown_attributes.removeAttribute('data-drupal-selector') %}
{% endif %}

{% set is_multiple = attributes.multiple is defined and attributes.multiple == 'multiple' %}
{% set selected_labels = [] %}
{% set option_selected = 'Select...' | t %}

<select {{ select_attributes }} {% if is_multiple %}multiple{% endif %}>
  {% for option in options %}
    {% if option.type == 'optgroup' %}
      <optgroup label="{{ option.label }}">
        {% for sub_option in option.options %}
          <option value="{{ sub_option.value }}"{{ sub_option.selected ? ' selected="selected"' }}>{{ sub_option.label }}</option>
          {% if sub_option.selected %}
            {% set selected_labels = selected_labels|merge([sub_option.label]) %}
          {% endif %}
        {% endfor %}
      </optgroup>
    {% elseif option.type == 'option' %}
      <option value="{{ option.value }}"{{ option.selected ? ' selected="selected"' }}>{{ option.label }}</option>
      {% if option.selected %}
        {% set selected_labels = selected_labels|merge([option.label]) %}
      {% endif %}
    {% endif %}
  {% endfor %}
</select>

{% if is_multiple %}
  {% set option_selected = selected_labels ? selected_labels|join(', ') : 'Select...' | t %}
  {% set dropdown_attributes = dropdown_attributes.addClass(['dropdown-multiselect', 'dropdown']) %}
  <div {{ dropdown_attributes }}>
    <button type="button" class="dropdown-button" role="button" id="{{ attributes.id }}-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
      {{ option_selected }}
      <span class="menu-arrow">
        <img src="/themes/custom/dge_theme/images/icons/blue-arrow.svg" alt="">
      </span>
    </button>
    <ul class="dropdown-menu" aria-labelledby="{{ attributes.id }}-dropdown">
      {% for option in options %}
        <li>
          <label class="dropdown-item">
            <input 
              type="checkbox" 
              name="{{ attributes.id }}[]" 
              value="{{ option.value }}" 
              {% if option.selected %}checked{% endif %}>
            {{ option.label }}
          </label>
        </li>
        {% for sub_option in option.options %}
          <li>
            <label class="dropdown-item">
              <input 
                type="checkbox" 
                name="{{ attributes.id }}[]" 
                value="{{ sub_option.value }}" 
                {% if sub_option.selected %}checked{% endif %}>
              {{ sub_option.label }}
            </label>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
{% else %}
  {% set option_selected = selected_labels|first ?: 'Select...' | t %}
  {% set dropdown_attributes = dropdown_attributes.addClass('dropdown') %}
  <div {{ dropdown_attributes }}>
    <button type="button" class="dropdown-button" role="button" id="{{ attributes.id }}-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
      {{ option_selected }}
      <span class="menu-arrow">
        <img src="/themes/custom/dge_theme/images/icons/blue-arrow.svg" alt="">
      </span>
    </button>
    <ul class="dropdown-menu" aria-labelledby="{{ attributes.id }}-dropdown">
      {% for option in options %}
        {% if option.value == 'custom_content_type_ckan' %}
          <li>
            <a class="dropdown-item special-highlight" idParent="{{ attributes.id }}-dropdown" idSelect="{{ attributes.id }}" data-value="{{ option.value }}">
              {{ option.label }}
            </a>
          </li>
        {% else %}
          <li>
            <a class="dropdown-item" idParent="{{ attributes.id }}-dropdown" idSelect="{{ attributes.id }}" data-value="{{ option.value }}">
              {{ option.label }}
            </a>
          </li>
        {% endif %}
        {% for sub_option in option.options %}
          <li>
            <a class="dropdown-item" idParent="{{ attributes.id }}-dropdown" idSelect="{{ attributes.id }}" data-value="{{ sub_option.value }}">
              {{ sub_option.label }}
            </a>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% endapply %}



