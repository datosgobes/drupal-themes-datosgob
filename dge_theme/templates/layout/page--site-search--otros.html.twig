  <header role="banner">
    <div class="banner-container">
      {{ page.header_left }}
      {{ page.header_right }}
      </div>
  </header>
  
  <div class="banner-fixed">
    <div class="banner-fixed-container">
      {{ page.primary_menu }}
      {{ page.secondary_menu }}
    </div>
  </div>

  <div class="breadcrumb-container">
    {{ page.breadcrumb }}
  </div>

<div class="layout-container">

  {{ page.highlighted }}
  <main role="main">
    <a id="main-content" tabindex="-1"></a>

    <div class="layout-content layout-content--otros">
      {{ page.content }}
    </div>

  </main>

</div>

<footer role="contentinfo">
  {{ page.footer_top }}
  <div class="footer-info">
    <div class="footer-info__container">
      {{ page.footer_left }}
      {{ page.footer_right }}
    </div>
  </div>
  <div class="footer-colaborators">
    {{ page.footer }}
  </div>
</footer>
