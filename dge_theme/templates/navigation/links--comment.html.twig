{% if links %}
  {% if heading %}
    {% if heading.level %}
      <{{ heading.level }}{{ heading.attributes }}>{{ heading.text }}</{{ heading.level }}>
    {% else %}
      <h2{{ heading.attributes }}>{{ heading.text }}</h2>
    {% endif %}
  {% endif %}

  <ul{{ attributes.addClass('comment-actions') }}>
    {% set action_icons = {
      'comment-delete': '/themes/custom/dge_theme/images/icons/operation-comment_delete.svg',
      'comment-edit': '/themes/custom/dge_theme/images/icons/operation-comment_edit.svg',
      'comment-approve': '/themes/custom/dge_theme/images/icons/operation-comment_approve.svg',
      'comment-reply': '/themes/custom/dge_theme/images/icons/operation-comment_reply.svg'
    } %}

    {% set action_labels = {
      'comment-delete': 'Delete'|t,
      'comment-edit': 'Edit'|t,
      'comment-approve': 'Approve'|t,
      'comment-reply': 'Reply'|t
    } %}

    {%- for key, item in links -%}
      {%- if item.link -%}
        <li{{ item.attributes }}>
          <a href="{{ item.link['#url'] }}" title="{{ item.link['#title'] }}" class="comment-actions__item">
            {% set icon_path = action_icons[key]|default('/themes/custom/dge_theme/images/icons/operation-list_default.svg') %}
            <span class="operation-item">
              <img src="{{ icon_path }}" alt="{{ action_labels[key]|default(item.link['#title']) }}">
            </span>
            <span class="operation-text">{{ action_labels[key]|default(item.link['#title']) }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor %}
  </ul>
{% endif %}
