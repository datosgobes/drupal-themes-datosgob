{% if links -%}
  {%- if heading -%}
    {%- if heading.level -%}
      <{{ heading.level }}{{ heading.attributes }}>{{ heading.text }}</{{ heading.level }}>
    {%- else -%}
      <h2{{ heading.attributes }}>{{ heading.text }}</h2>
    {%- endif -%}
  {%- endif -%}

  <div class="dropdown language-switcher">
    <a href="#" class="language" tabindex="0" aria-haspopup="true" aria-expanded="false"> 
      <span class="language-state" title="{{ 'Language'|t }}">{{ current_language |upper}} </span>
      <span class="language-arrow"><img src="/themes/custom/dge_theme/images/icons/simple-arrow.svg" alt="Simple arrow icon"></span>
    </a>

    <ul{{ attributes.addClass('links') }}> 
      {%- for item in links -%}
        <li{{ item.attributes }}>
          {%- if item.link -%}
            {{ item.link }}
          {%- elseif item.text_attributes -%}
            <span{{ item.text_attributes }}>{{ item.text }}</span>
          {%- else -%}
            {{ item.text }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

{%- endif %}
