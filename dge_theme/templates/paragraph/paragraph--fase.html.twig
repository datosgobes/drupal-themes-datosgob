{%
    set classes = [
      'paragraph',
      'paragraph--type--' ~ paragraph.bundle|clean_class,
      view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
      not paragraph.isPublished() ? 'paragraph--unpublished'
    ]
  %}
  {% block paragraph %}
  <div class="entity entity-paragraphs-item paragraphs-item-custom" about="" typeof="">
    <div class="content">
      <div class="contenidoFase {% if elements.field_image_position[0]['#markup'] == 'Izquierda' %}image-left{% else %}image-right{% endif %}">
        {% if elements.field_image_position[0]['#markup'] == 'Izquierda' %}
          <div class="imagen">
            {{ elements.field_image }}
          </div>
          <div class="descripcion">
            {{ elements.field_description }}
          </div>
        {% else %}
          <div class="descripcion">
            {{ elements.field_description }}
          </div>
          <div class="imagen">
            {{ elements.field_image }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock paragraph %}
