{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}

      {# Twig accesible para dataset cards #}
      <article class="dataset-card" role="region"
         aria-labelledby="dataset-title-{{ content.field_titulo[0]['#context'].value|clean_id }}">

        <div class="dataset-card__image">
          {% if content.field_imagen_media is not empty %}
            <div class="dataset-card__image__src">
              {{ content.field_imagen_media }}
            </div>
          {% endif %}

          <h2 id="dataset-title-{{ content.field_titulo[0]['#context'].value|clean_id }}"
              class="dataset-card__image__title">
            {{ content.field_titulo[0]['#context'].value }}
            <span class="decoration-line decoration-line__sm decoration-line__white"
                  aria-hidden="true"></span>
          </h2>
        </div>

        <div class="dataset-card__description">
          <div class="dataset-card__description__text">
            {{ content.field_description }}
          </div>
      
          {% if content.field_url[0]['#url'] is defined and content.field_url[0]['#url'].uri is defined %}
            <div class="dataset-card__description__link">
              <a href="{{ content.field_url[0]['#url'] }}">
                {{ 'View data set'|t }}
              </a>
            </div>
          {% endif %}
        </div>

      </article>

    {% endblock %}
  </div>
{% endblock paragraph %}

