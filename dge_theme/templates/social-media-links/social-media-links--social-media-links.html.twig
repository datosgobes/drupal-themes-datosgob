{#
/**
 * Available variables
 * - elements: array of element contains social media link.
 *
 */
#}



<span class="share-icon" title="{{ 'Share'|t }}">
  <img src="/themes/custom/dge_theme/images/icons/share.svg" alt="Share icon">
</span>

{% set classes = [
  'share'
] %}

<div class="dialog-opacity"></div>
<section class="dialog">
  <div class="dialog-container" role="dialog">
    <div class="dialog-close">
      <button aria-label="Cerrar" type="button">
      <span><img src="/themes/custom/dge_theme/images/icons/close.svg" alt="Close icon"></img></span>
      </button>
    </div>
    <div class="dialog-content" role="dialog" tabindex="-1" aria-modal="true">
      <div class="dialog-content__title mb-6" role="dialog">
        <h3>
          <span class="field field--name-title">{{ 'Share this content' | t }}</span>
        </h3>
      </div>
      <div class="dialog-content__rrss">
        {% for element in elements %}
          {% if element.forward_dialog == 1 %}
            {% set classes = classes|merge(['use-ajax']) %}
            {% set dialogType = "data-dialog-type=dialog" %}
            {% set dialogOptions = "data-dialog-options=" ~ {'width': '600'}|json_encode %}
          {% endif %}
          <div class="dialog-content__rrss__item" role="dialog">
            <a {{ dialogType }} {{ dialogOptions }} {{ element.attr.target }} {{ element.attr.rel }} {{ element.attr.class.addClass(classes) }} {{ element.api }}
              title="{{ element.text | t }}" target="_blank">
              {% if element.img %}
                <img class="mr-4 ml-4" alt="{{ element.text }}" src="{{ element.img }}"><span>{{ element.text | t }}</span>
              {% else %}
                {{ element.text | t }}
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

