{%
  set classes = [
    'taxonomy-term',
    'vocabulary-' ~ term.bundle|clean_class,
  ]
%}
<div{{ attributes.setAttribute('id', 'taxonomy-term-' ~ term.id).addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <div class="card-status" style="background-color:{{ elements['#taxonomy_term'].field_color.color }}">
    <span class="card-status__icon">
        <img src="{{file_url(elements['#taxonomy_term'].get('field_icono').entity.uri.value)}}" 
            alt="{{elements['#taxonomy_term'].field_icono.alt}}"
            width="{{elements['#taxonomy_term'].field_icono.width}}"
            height="{{elements['#taxonomy_term'].field_icono.width}}">
        </img>
    </span>
    <span class="card-status__name">{{ name }}</span>
  </div>
</div>
