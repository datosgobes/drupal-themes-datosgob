{{ categoria.separator }}
{%- if categoria.wrapper_element -%}
<{{ categoria.wrapper_element }}{{ categoria.wrapper_attributes }}>
{%- endif %}
{%- if categoria.label -%}
{%- if categoria.label_element -%}
<{{ categoria.label_element }}{{ categoria.label_attributes }}>
    {{ categoria.label }}{{ categoria.label_suffix }}
</{{ categoria.label_element }}>
{%- else -%}
{{ categoria.label }}{{ categoria.label_suffix }}
{%- endif %}
{%- endif %}

{%- if categoria.element_type -%}
<{{ categoria.element_type }}{{ categoria.element_attributes }}>
    {%- set categories = categoria.content|striptags|trim|split(',') %}
    {%- for category in categories[:3] %}
        {%- set category_entity = drupal_entity('taxonomy_term', category|trim) %}
        <div class="flex-display flex-center">
            <div class="flex-display decoration-dot"
                style="background-color:{{ category_entity['#taxonomy_term'].field_color.color }}"></div>
            <div class="flex-display">
                {{ category_entity['#taxonomy_term'].name.value }}
            </div>
        </div>
    {%- endfor %}
    {%- if categories|length > 3 %}
    <span class="ml-2">+{{ categories|length - 3 }}</span>
    {%- endif %}
</{{ categoria.element_type }}>
{%- else -%}
{{ categoria.content }}
{%- endif %}
{%- if categoria.wrapper_element -%}
</{{ categoria.wrapper_element }}>
{%- endif %}