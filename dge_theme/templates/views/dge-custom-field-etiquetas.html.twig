{{ etiquetas.separator }}
  {%- if etiquetas.wrapper_element -%}
  <{{ etiquetas.wrapper_element }}{{ etiquetas.wrapper_attributes }}>
    {%- endif %}
    {%- if etiquetas.label -%}
    {%- if etiquetas.label_element -%}
    <{{ etiquetas.label_element }}{{ etiquetas.label_attributes }}>{{
      etiquetas.label }}{{ etiquetas.label_suffix }}</{{
      etiquetas.label_element }}>
    {%- else -%}
    {{ etiquetas.label }}{{ etiquetas.label_suffix }}
    {%- endif %}
    {%- endif %}

    {%- if etiquetas.element_type -%}
    <{{ etiquetas.element_type }}{{ etiquetas.element_attributes }}>
      {%- set labels = etiquetas.content|split(',') %}
      {%- for label in labels[:3] %}
      {{- label|raw -}}
      {%- endfor %}
      {%- if labels|length > 3 %}
      <span class="ml-2">+{{ labels|length - 3 }}</span>
      {%- endif %}
    </p{{ etiquetas.element_type }}>
    {%- else -%}
    {{ etiquetas.content }}
    {%- endif %}
    {%- if etiquetas.wrapper_element -%}
  </{{ etiquetas.wrapper_element }}>
  {%- endif %}