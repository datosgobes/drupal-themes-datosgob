{# Set the URL of the node #}
{% set node_url = path('entity.node.canonical', {'node': row._entity.id}) %}

<a href="{{ node_url }}">
  <div class="container flex-justify-between container--first">
    <div class="flex-display flex-column flex-justify-between">
      <div class="flex-display flex-column">
        <div class="flex-display flex-center mb-2">
          {% set params = {
            field: fields.title
            } 
          %}
          
          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
        </div>
      </div>
      <div class="flex-display flex-center mb-2">
        {% set params = {
          field: fields.field_autor_desarrollador
          } 
        %}
        
        {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
      </div>
    </div>
    <div class="flex-display flex-center mb-2">
      {% set params = {
        field: fields.field_imagen
        } 
      %}
      
      {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
    </div>
  </div>

</a>
