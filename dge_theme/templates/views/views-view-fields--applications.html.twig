{# Set the URL of the node #}
{% set node_url = path('entity.node.canonical', {'node': row._entity.id}) %}

<a href="{{ node_url }}">
  <div class="container flex-justify-between container--first flex-nowrap">
    <div class="flex-display flex-column">
      <div class="flex-display flex-column">
        <div class="flex-display flex-center mb-2">
          {% set params = {
            field: fields.title
            } 
          %}
          
          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
        </div>
        <div class="flex-display flex-center mb-2">
          {% set params = {
            categoria: fields.field_categoria
            } 
          %}
          
          {% include directory ~ '/templates/views/dge-custom-field-categoria.html.twig' with params %}
        </div>
      </div>
      <div class="flex-display flex-center mb-2">
        {% set params = {
          field: fields.field_autor_desarrollador
          } 
        %}
        <div>
          <span class="text--italic regular primary-color-semi-dark mb-0 mr-2">{{ 'Author/Developer:' | t }}</span>
          <span class="primary-color-dark regular text--bold">{{ fields.field_autor_desarrollador.content | raw }}</span>
        </div>
      </div>
    </div>
    <div class="flex-display flex-center mb-2">
      {% set params = {
        field: fields.field_imagen
        } 
      %}
      
      {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
    </div>
  </div>

  <div class="container">
    {% set params = {
      field: fields.field_descripcion_terms,
      strip_tags: true
      } 
    %}
    
    {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
  </div>
</a>

<div class="container flex-column pt-4 w--100 flex-justify-between">
  <div class="flex-display flex-center w--100 mb-2">
    {% set params = {
      etiquetas: fields.field_etiquetas
      } 
    %}
    
    {% include directory ~ '/templates/views/dge-custom-field-etiquetas.html.twig' with params %}
  </div>

  <div class="flex-display mb-2 w--100 flex-justify-between responsive-lg-flex-column">
    {% set fecha_render = fields.field_fecha_de_publicacion.content %}
    {% if fecha_render %}
    <div class="flex-display flex-center regular datetimeViews">
      <span class="flex-display icon--md mr-2"><img src="/themes/custom/dge_theme/images/icons/calendario.svg"
          alt="calendar icon"></span>
      {{ fecha_render}}
    </div>
    {% endif %}

    {% if fields.field_plataforma.content|render|trim matches '/<a[^>]*>/' %}
    <div class="flex-display mt-2 mb-2">
      {% set params = {
        field: fields.field_plataforma,
        strip_tags: true
        } 
      %}
      
      {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
    </div>
    {% endif %}

  </div>
</div>