{% set node_url = path('entity.node.canonical', {'node': row._entity.id}) %}

{% set descripcion = fields.field_descripcion.content|striptags|trim is not empty ? fields.field_descripcion : (fields.body.content|striptags|trim is not empty ? fields.body : null) %}
{% set tipo = fields.type.content|striptags|trim is not empty ? fields.type : null %}

{% if tipo.content|render|striptags|trim == 'FAQ' %}
  {% set language_code = node_url|split('/')[1] %}
  {% set categoria = fields.field_faq_category.content|striptags|trim|lower|replace({' ': '-', 'á': 'a', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ñ': 'n'}) %}
  {% set nodeId = fields.search_api_id.content|striptags|trim|replace({'entity:node/': '', ':es': ''}) %}
  {% set taxonomy_id = fields.field_faq_category.content|render|split('href="')[1]|split('"')[0]|split('/')|last %}

  {% set custom_url_faq = '/' ~ language_code ~ '/preguntas-frecuentes/faq_categoria/' ~ categoria ~ '-' ~ taxonomy_id ~ '#faq-' ~ nodeId %}
 
{% endif %}


{% set params = {
  title: fields.title,
  descripcion: descripcion,
  tipo: tipo,
  
  }
%}
{% include directory ~ '/templates/views/dge-custom-views-view-fields.html.twig' with params %}

