{% set node_url = path('entity.node.canonical', {'node': row._entity.id}) %}

<a href="{{ node_url }}">
  <div class="container flex-justify-between">
    <div class="flex-display w--100 flex-column">

      <div class="container--first flex-display flex-row flex-justify-between">
        <div class="flex-display flex-center mb-2">
          {% set params = {
          field: fields.title
          }
          %}

          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
        </div>
        <div class="flex-display flex-center mb-4">
          {% set params = {
          field: fields.field_estado
          }
          %}

          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
        </div>
      </div>

      <div class="flex-display flex-column">
        <div class="flex-display flex-center mb-2">
          {% set params = {
          categoria: fields.field_categoria
          }
          %}

          {% include directory ~ '/templates/views/dge-custom-field-categoria.html.twig' with params %}
        </div>
      </div>

      <div class="flex-display flex-column">
        <div class="flex-display flex-center mb-2">
          {% set params = {
          field: fields.field_organismo_responsable,
          strip_tags: true
          }
          %}
          {% set content = fields.field_organismo_responsable.content|render %}
          {% set extracted_text = content|striptags|trim %}
          
          {% if extracted_text is not empty %}
          <div>
            <span class="text--italic regular primary-color-semi-dark mb-0 mr-2">{{ 'Body responsible:' | t }}</span>
            <span class="primary-color-dark regular text--bold">{{ extracted_text}}</span>
          </div>
          {% endif %}
        </div>
      </div>

      <div class="flex-display flex-column">
        <div class="flex-display flex-center mb-2">
          {% set params = {
          field: fields.field_descripcion,
          strip_tags: true
          }
          %}

          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
        </div>
      </div>

      <div class="flex-display flex-row pt-4 w-100 flex-justify-between">
        {% set fecha_render = fields.created.content %}
        {% if fecha_render %}
        <div class="flex-display flex-center regular datetimeViews">
          <span class="flex-display icon--md mr-2"><img src="/themes/custom/dge_theme/images/icons/calendario.svg"
              alt="calendar icon"></span>
          {{ fecha_render }}
        </div>
        {% endif %}

        <div class="flex-display flex-gap-05 flex-center regular text--bold w-100">
          <div class="flex-display">
            <span class="icon--md">
              <img src="/themes/custom/dge_theme/images/icons/follower.svg" alt="seguidores de la petición">
            </span>
          </div>
          {% set params = {
            field: fields.field_number_subscriptors
            }
          %}
          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
          <span>{{ 'requesters' | t }}</span>
        </div>
      </div>
    </div>
  </div>
</a>
