{% set node_url = path('entity.node.canonical', {'node': row._entity.id}) %}

<a href="{{ node_url }}">
  <div class="container flex-justify-between">
    <div class="container--first flex-display flex-justify-between w--100 flex-gap-1 flex-justify-between">

      <div class="flex-display flex-column">
        <div class="flex-display flex-center mb-2">
          {% set params = {
            field: fields.title
            } 
          %}
          
          {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
        </div>

        <div class="flex-display flex-center mb-2">
          {% set params = {
            categoria: fields.field_categoria
            } 
          %}
          
          {% include directory ~ '/templates/views/dge-custom-field-categoria.html.twig' with params %}
        </div>

        <div class="flex-display mb-2 flex-center flex-gap-1">
          {{ fields.field_year_create_reuse_co.separator }}
          {%- if fields.field_year_create_reuse_co.wrapper_element -%}
          <{{ fields.field_year_create_reuse_co.wrapper_element }}{{ fields.field_year_create_reuse_co.wrapper_attributes }}>
            {%- endif %}
            {%- if fields.field_year_create_reuse_co.label -%}
            {%- if fields.field_year_create_reuse_co.label_element -%}
            <{{ fields.field_year_create_reuse_co.label_element }}{{ fields.field_year_create_reuse_co.label_attributes }}>{{
              fields.field_year_create_reuse_co.label }}{{ fields.field_year_create_reuse_co.label_suffix }}</{{
              fields.field_year_create_reuse_co.label_element }}>
            {%- else -%}
            {{ fields.field_year_create_reuse_co.label }}{{ fields.field_year_create_reuse_co.label_suffix }}
            {%- endif %}
            {%- endif %}
            {%- if fields.field_year_create_reuse_co.element_type -%}
              <div>
                <span class="text--italic regular primary-color-semi-dark mb-0 mr-2">{{ 'Founded in:' | t }}</span>
                <{{ fields.field_year_create_reuse_co.element_type }}{{ fields.field_year_create_reuse_co.element_attributes }}>
                <span class="primary-color-dark regular text--bold">{{fields.field_year_create_reuse_co.content }} </{{ fields.field_year_create_reuse_co.element_type }}></span>
              </div>
            {%- else -%}
            {{ fields.field_year_create_reuse_co.content }}
            {%- endif %}
            {%- if fields.field_year_create_reuse_co.wrapper_element -%}
          </{{ fields.field_year_create_reuse_co.wrapper_element }}>
          {%- endif %}
      
          {% if fields.field_sede_central.content is not empty %}
          <div>
            <span class="text--italic regular primary-color-semi-dark mb-0 mr-2">{{ 'Headquarters:' | t }}</span>
            <span class="primary-color-dark regular text--bold">{{fields.field_sede_central.content}}</span>
          </div>
          {% endif %}

        </div>

      </div>

      <div class="flex-display flex-center mb-2 views-field-field-imagen__company">
        {% set params = {
          field: fields.field_imagen
          } 
        %}
        
        {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
      </div>
    </div>
  </div>

  <div class="container">
    {% set params = {
      field: fields.field_descripcion,
      strip_tags: true
      } 
    %}
    
    {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
  </div>

</a>
  
<div class="container flex-column pt-4 w-100 flex-justify-between">
  <div class="flex-display flex-center w--100 mb-2">
    {% set params = {
      etiquetas: fields.field_etiquetas
      } 
    %}
    
    {% include directory ~ '/templates/views/dge-custom-field-etiquetas.html.twig' with params %}
  </div>

  {% set fecha_render = fields.field_fecha_publicacion_contenid.content %}
  {% if fecha_render %}
  <div class="flex-display flex-center regular datetimeViews">
    <span class="flex-display icon--md mr-2"><img src="/themes/custom/dge_theme/images/icons/calendario.svg"
        alt="calendar icon"></span>
    {{ fecha_render }}
  </div>
  {% endif %}
  
  
</div>