<div class="views-row__question" tabindex="0" onclick="toggleVisibility(this)" onkeydown="handleKeyPress(event)" 
id="faq-{% if fields.nid_1 is defined %}{{ fields.nid_1.content|striptags|trim }}{% else %}missing-id{% endif %}">

  {% set params = { field: fields.title } %}
  {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
  <span class="arrow"><img src="/themes/custom/dge_theme/images/icons/blue-arrow.svg" alt=""></span>
</div>


<div class="views-row__content" style="display: none;" id="faq-content-{{ fields.nid.content }}">
  {% set detailed_question = fields.field_detailed_question.content|render|striptags|trim %}
  {% if detailed_question is not empty %}
  <div class="views-row__content__question-detailed">
    {% set params = { field: fields.field_detailed_question } %}
    {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
    <div class="decoration-line"></div>
  </div>
  {% endif %}
  <div class="views-row__content__answer">
    {% set params = { field: fields.body } %}
    {% include directory ~ '/templates/views/dge-custom-field.html.twig' with params %}
  </div>
</div>



