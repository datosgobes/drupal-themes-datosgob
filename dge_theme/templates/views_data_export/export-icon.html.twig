{#
/**
 * @file
 * Default theme implementation for an export icon.
 *
 * Available variables:
 * - url: An internal system path of the data export.
 * - attributes: Remaining HTML attributes for the export link.
 *   - format: The export format (csv, json, xml).
 *   - class: HTML classes to be applied to the export link.
 *
 * @ingroup themeable
 */
#}

<a href="{{ url }}"{{ attributes.addClass('export-link flex-justify-center mt-6') }}>
  <span class="operation-item">
    <img src="/themes/custom/dge_theme/images/icons/export-icon.svg" alt="exportar tabla">
    {% if 'panel-de-trabajo/initiatives/export-admin' in url %}
      {{ 'Exportación completa @format'|t({'@format': format}) }}
    {% else %}
      {{ 'Exportar como @format'|t({'@format': format}) }}
    {% endif %}
  </span>
</a>