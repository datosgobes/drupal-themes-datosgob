{{ element.elements.markup }}

<div class="mt-8">
  <form{{ attributes }}>

    {# Información obligatoria (ya existente) #}
    {% set params = { element: element } %}
    {% include directory ~ '/templates/webform/dge-custom-webform--datos-obligatorios.html.twig' with params %}

    {# === DATOS DE CONTACTO === #}
    <fieldset class="container">
      <legend class="visually-hidden">Nombre y mail</legend>
      <div class="col-3">
        {{ element.elements.name }}
      </div> 

      <div class="col-3">
        {{ element.elements.email }}
      </div>
    <div class="col-3" title="{{ 'Select an item from the list'|t }}">
      {{ element.elements.tipo }}
      </div>
    </fieldset>

    {# === MENSAJE === #}
    <fieldset class="container">
      <legend class="visually-hidden">
        {{ 'Message'|t }}
      </legend>

      <div class="col-1">
        {{ element.elements.message }}
      </div>
    </fieldset>

    {# === CONSENTIMIENTO === #}
    <fieldset class="container">
      <legend class="visually-hidden">
        {{ 'Select this checkbox if you want to continue'|t }}
      </legend>

      <div class="col-1">
        {{ element.elements.acepto_las_condiciones_de_servicio }}
      </div>
    </fieldset>

    {# === ACCIONES === #}
    <div class="container flex-justify-center mt-6 mb-6">
      <div class="col-3">
        {{ element.elements.actions }}
      </div>
    </div>

  </form>
</div>
