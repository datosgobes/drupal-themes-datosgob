{{ element.elements.markup }}

<div class="mt-8">
  <form{{ attributes }}>
    {% set params = {
      element: element
      }
    %}
    {% include directory ~ '/templates/webform/dge-custom-webform--datos-obligatorios.html.twig' with params %}

    <fieldset class="container">
      <h4 class="mb-3 titleBold">{{ 'Request Information' | t }}</h4>
      <legend class="mb-3 titleBold visually-hidden">
        {{ 'Request Information' | t }}
      </legend>
    
      <div class="container">
        <div class="col-66 form-wrapper">
        {{ element.elements._que_datos_solicita_ }}
        </div>
        <div class="col-3" title="{{ 'Select an item from the list'|t }}">
        {{ element.elements.categorias }}
        </div>
      </div>
      <div class="container">
        <div class="col-1">
        {{ element.elements.descripcion }}
        </div>
      </div>

      <div class="container">
        <div class="col-1">
        {{ element.elements.motivo_de_peticion }}
        </div>
      </div>

      <div class="container">
        <div class="col-1">
        {{ element.elements.beneficios_esperados }}
        </div>
      </div>
    </fieldset>
    <!-- Peticion de acceso NSIP - Datos de contacto -->
    {% set altTitle = 'Requester Information' | t %}
    {% set params = {
      title: altTitle,
      name_and_surname: element.elements.nombre_y_apellidos,
      email: element.elements.correo_electronico,
      company: element.elements.organizacion,
      consent_1: element.elements.check_de_consentimiento,
      }
    %}
    {% include directory ~ '/templates/form/dge-custom-form-datos-de-contacto.html.twig' with params %}
    
    {{ element.elements.markup_01 }}
    {{ element.elements.markup_02 }}

    <fieldset class="container flex-justify-center mt-6 mb-6">
    <legend class="visually-hidden">Enviar</legend>
      <div class="col-3">
        {{ element.elements.actions }}
      </div>
    </fieldset>
  </form>
</div>
